{
  "name": "appresso",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "Database",
    "BackEnd",
    "FrontEnd"
  ],
  "scripts": {
    "dev:backend": "npx tsx watch BackEnd/src/server.ts",
    "dev:frontend": "npm --workspace=FrontEnd run dev",
    "build:frontend": "npm --workspace=FrontEnd run build",
    "build": "npm --workspace=FrontEnd run build",
    "simular": "npx tsx scripts/simulador-transacciones.ts",
    "simulador": "npx tsx scripts/simulador-transacciones.ts",
    "test": "vitest run BackEnd/tests"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "pino-pretty": "^13.1.3",
    "vitest": "^5.0.4"
  }
}
